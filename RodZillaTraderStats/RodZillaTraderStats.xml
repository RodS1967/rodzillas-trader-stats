<GuiXml>
    <Controls>
        <TopLevelControl name="RodZillaTraderStatsWindow" hidden="true" mouseEnabled="true"
            clampedToScreen="true">
            <Dimensions x="760" y="500" />
            <Anchor point="CENTER" />
            <Controls>
                <Backdrop name="$(parent)Bg" integralWrapping="true">
                    <AnchorFill />
                    <Edge file="EsoUI/Art/ChatWindow/chat_BG_edge.dds" edgeFileWidth="256"
                        edgeFileHeight="256" edgeSize="32" />
                    <Center file="EsoUI/Art/ChatWindow/chat_BG_center.dds" />
                    <Insets left="32" top="32" right="-32" bottom="-32" />
                </Backdrop>

                <Label name="$(parent)Title" font="ZoFontWinH3" text="RodZilla's Trader Stats">
                    <Anchor point="TOP" offsetY="20" />
                </Label>

                <Button name="$(parent)Close" inherits="ZO_CloseButton">
                    <Anchor point="TOPRIGHT" offsetX="-4" offsetY="4" />
                    <OnClicked>
                        SCENE_MANAGER:ShowBaseScene()
                    </OnClicked>
                </Button>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
